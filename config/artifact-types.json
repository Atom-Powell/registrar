  "universalStructure": {
    "$comment": "Every generated artifact carries these elements in this order, per Spec Section 4.1. These are code-defined renderer components driven purely by validated metadata - never delegated to LLM content.",
    "orderedElements": [
      "Header table (ORG cloud mark + three-line title stack)",
      "DOCUMENT CONTROL HEADER banner label",
      "Document Control Header (Row 1: Document ID, Version, Classification, Approval Status; Row 2: Owner, Review Date, Audience, Prepared By)",
      "Configuration callout (Artifact, Description, Audience, Settings + ID Pattern)",
      "Numbered body sections per artifact sectionSchema",
      "Distribution and Follow-up",
      "Prepared-by and companion-artifact closing line",
      "Footer (Confidential line | [PACKAGE] | [ARTIFACT] | v[VERSION] | Page X of Y | ORG Consulting, LLC)"
    ]
