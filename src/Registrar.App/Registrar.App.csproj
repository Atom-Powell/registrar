<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- This app hosts Razor components inside a WPF window. Microsoft.NET.Sdk.Razor as
       the outer Sdk (rather than plain Microsoft.NET.Sdk) is what makes the .razor
       files compile as components instead of being globbed as None; the .NET SDK
       resolver still adds WPF support for UseWPF underneath it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="8.0.100" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Registrar.Core\Registrar.Core.csproj" />
    <ProjectReference Include="..\Registrar.Validation\Registrar.Validation.csproj" />
    <ProjectReference Include="..\Registrar.Pipeline\Registrar.Pipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\config\generated\org-tokens.css"
             Link="wwwroot\org-tokens.css"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\org-logo.png"
             Link="wwwroot\org-logo.png"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Static web assets are copied to the publish directory by default but not to the
       build output, and BlazorWebView reads HostPage directly from disk beside the
       executable rather than through the ASP.NET Core static-file pipeline. Without
       this, "dotnet run" produces an executable with no wwwroot and the host page
       never loads. -->
  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
